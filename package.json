{
  "name": "@hello.nrfcloud.com/proto",
  "version": "0.0.0-development",
  "description": "Documents the communication protocol between the hello.nrfcloud.com backend and the web application",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./export.js"
    },
    "./fingerprint": {
      "default": "./dist/fingerprint/export.js",
      "types": "./fingerprint/index.d.ts"
    },
    "./hello": {
      "default": "./dist/hello/export.js",
      "types": "./hello/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/proto.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/proto/issues"
  },
  "homepage": "https://hello.nrfcloud.com",
  "keywords": [
    "nordicsemiconductor",
    "cellular-iot",
    "hello-nrfcloud"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "test": "node --no-warnings --experimental-transform-types --test \"!(node_modules)/**/*.spec.ts\"",
    "test:watch": "node --no-warnings --experimental-transform-types --test --watch \"!(node_modules)/**/*.spec.ts\"",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "prepublishOnly": "node --experimental-strip-types ./.npm/compile.ts"
  },
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "8.0.3",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@types/node": "26.4.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "chalk": "6.0.0",
    "check-node-version": "4.2.1",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "nock": "14.0.17",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml,html}": [
      "prettier --write"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "export.js",
    "index.d.ts",
    "dist",
    "nrfCloud",
    "hello",
    "fingerprint",
    "validator",
    "schemas",
    "generate"
  ],
  "peerDependencies": {
    "@hello.nrfcloud.com/proto-map": "^17.1.1",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "jsonata": "^2.2.2"
  }
}
